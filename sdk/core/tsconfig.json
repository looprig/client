{
  "compilerOptions": {
    "target": "ES2022",
    // "DOM" supplies fetch/Response/RequestInit/Headers/AbortSignal/
    // URLSearchParams — the real browser types transport.ts's BFFTransport is
    // written against (SPEC framing: "same-origin browser apps"). This is a
    // TypeScript-bundled lib, not a new dependency.
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
